[Unit]
Description=Bitcoin Core testnet4 pruned node (Olesia faucet/wallet, own-node reconciliation + alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faucet
ExecStart=/usr/local/bin/bitcoind -datadir=/var/lib/bitcoind-testnet4 -conf=/var/lib/bitcoind-testnet4/bitcoin.conf
Restart=on-failure
RestartSec=45
TimeoutStopSec=300
Nice=5
# testnet only, no funds; read-only public P2P. Keep it contained.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
