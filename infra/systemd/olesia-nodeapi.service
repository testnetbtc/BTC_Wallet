[Unit]
Description=Olesia node API (localhost:8787 -> own bitcoind: UTXO lookup, fees, prev-tx, broadcast)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faucet
# split-key vanity jobs: 8 of 18 threads under nice -n 19; measured 272k keys/s; cap 15 min expected
Environment=OLESIA_VANITY_THREADS=8
Environment=OLESIA_VANITY_RATE=250000
Environment=OLESIA_VANITY_MAX_SECONDS=900
ExecStart=/home/faucet/.nvm/versions/node/v22.22.3/bin/node /home/faucet/BTC_Wallet/infra/nodeapi/server.mjs
Restart=on-failure
RestartSec=10
# The service needs no privileges: it talks JSON-RPC to the node on localhost and reads the
# node's bitcoin.conf for the RPC credentials. It writes nothing to disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# DoS containment (the vanity runner — 8 threads, nice 19 — lives in this cgroup too)
MemoryMax=2G
CPUQuota=900%
TasksMax=64

[Install]
WantedBy=multi-user.target
