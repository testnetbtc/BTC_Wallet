# Chainwatch backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# The offline Alea generator (root index.html) uses NONE of these — it must
# stay fully standalone and offline. These are for the VPS backend only.

# --- API service (services/api) ---
API_BIND=127.0.0.1          # localhost-only during this phase; do NOT make public yet
API_PORT=8080
API_JWT_SECRET=             # generated; used to sign session tokens
API_LOG_LEVEL=info

# --- PostgreSQL (services/*, packages/database) ---
# Prefer a URL that keeps the password out of shell history / process args where possible.
DATABASE_URL=postgres://chainwatch_app@127.0.0.1:5432/chainwatch
PGSSLMODE=disable           # localhost socket; TLS not required for loopback

# --- Encryption at rest for sensitive watch-only material (xpubs/descriptors) ---
# 32-byte key, base64. Generated off this template; stored outside git.
WATCHLIST_ENC_KEY=

# --- Bitcoin Core RPC (localhost only) ---
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_COOKIE=/var/lib/bitcoind/.cookie   # preferred: cookie auth
# If not using the cookie, set user/pass instead (localhost only):
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# --- Bitcoin Core ZMQ (localhost only) ---
ZMQ_RAWTX=tcp://127.0.0.1:28332
ZMQ_RAWBLOCK=tcp://127.0.0.1:28333
ZMQ_SEQUENCE=tcp://127.0.0.1:28334

# --- Telegram dispatcher (services/telegram) — optional until you wire alerts ---
TELEGRAM_BOT_TOKEN=         # leave blank during scaffolding; no token required to build
TELEGRAM_DEFAULT_CHAT_ID=   # a test chat id for delivery tests
